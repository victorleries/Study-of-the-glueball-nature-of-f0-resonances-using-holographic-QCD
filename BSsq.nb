e9ecaec026b4"],

Cell[CellGroupData[{

Cell["\<\
Numerical solutions for quark-antiquark meson Regge trajectories using \
Bohr-Sommerfeld semiclassical quantization\
\>", "Title",
 CellChangeTimes->{
  3.972815321989151*^9},ExpressionUUID->"3871e1c2-64f6-9748-96dc-\
e77083d2d2ff"],

Cell[TextData[{
 "The analytical solution using the approximation of considering the masses \
of the quarks negligible and the potential linear. So the Hamiltonian in the \
CM reference frame is M=2p+\[Sigma]r. And the analytical solution is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["M", "2"], "=", 
    RowBox[{"4", 
     RowBox[{"\[Sigma]", "(", 
      RowBox[{"n", "+", 
       FractionBox["1", "2"]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f76f13ed-017b-d543-b0cd-cd64419f7bea"],
 "."
}], "Text",
 CellChangeTimes->{{3.972815437714428*^9, 3.972815454425089*^9}, {
  3.9728155233599224`*^9, 3.9728155296078777`*^9}, {3.9728156184032383`*^9, 
  3.972815628987829*^9}, {3.972815744681305*^9, 3.9728158457057514`*^9}, {
  3.9728159344063263`*^9, 
  3.9728159762107506`*^9}},ExpressionUUID->"84803b76-97d4-f846-856a-\
2ecffdde618f"],

Cell[CellGroupData[{

Cell["\<\
Bohr-Sommerfeld semiclassical quantization for a more general potential\
\>", "Section",
 CellChangeTimes->{{3.9728153439189568`*^9, 
  3.9728153534779224`*^9}},ExpressionUUID->"ff73aa4e-dbdb-4240-8691-\
48ac47e260e9"],

Cell[TextData[{
 "The generalized potential in this case is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", 
              RowBox[{
                SubscriptBox[
                 StyleBox["r", "TI"], "0"], "-", 
                StyleBox["r", "TI"]}]], "-", 
             FractionBox["1", 
              SubscriptBox[
               StyleBox["r", "TI"], "0"]], 
             RowBox[{")", "\[Null]"}]}]}]}], TraditionalForm], "errors" -> {},
      "input" -> "V(r)=g\\Bigl(\\frac{1}{r_0-r}-\\frac{1}{r_0}\\Bigl)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ed9b20d-a400-3241-8d3b-8f349c4b66ef"],
 ". Once computed the integral let\[CloseCurlyQuote]s invert the function and \
plot it to compare it with the original solution."
}], "Text",
 CellChangeTimes->{{3.972815379657097*^9, 3.972815409475849*^9}, {
   3.9728159793019257`*^9, 3.9728159927021027`*^9}, 3.9728160802062016`*^9, {
   3.972816311442539*^9, 3.9728163485073433`*^9}, {3.9728164338637695`*^9, 
   3.9728165113510647`*^9}},ExpressionUUID->"114f6e69-4dae-be40-8cd2-\
d8d05c9a667c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"M", "=", 
  RowBox[{"InverseFunction", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#2", "-", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#1", "/", "#3"}], "+", 
               RowBox[{"1", "/", "#2"}]}], ")"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"#1", "+", 
            RowBox[{"#3", "/", "#2"}]}], ")"}]}], "+", 
         RowBox[{"#3", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"#1", "*", 
             RowBox[{"#2", "/", "#3"}]}], "+", "1"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"1", "/", "2"}]}], "&"}], ",", "1", ",", "3"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"RandomReal", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", 
   RowBox[{"RandomReal", "[", "10", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"g", "/", "r0"}]}], ";"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"x", ",", "r0", ",", "g"}], "]"}], "^", "2"}], ",", 
     RowBox[{"4", "sigma", "*", "Pi", 
      RowBox[{"(", 
       RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Proposed potential\>\"", ",", "\"\<Linear Potential\>\""}], 
     "}"}]}]}], "]"}]}], "Code",
 CellChangeTimes->{{3.97281693983786*^9, 3.9728169798317184`*^9}, {
