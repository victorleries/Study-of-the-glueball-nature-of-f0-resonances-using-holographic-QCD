Cell[CellGroupData[{

Cell["\<\
Dependance on g of the Regge trajectory for the proposed potential\
\>", "Section",
 CellChangeTimes->{{3.9764549490356503`*^9, 3.976454951232559*^9}, {
  3.9764550243490906`*^9, 
  3.976455048985655*^9}},ExpressionUUID->"cab48718-4c7b-a842-95e1-\
b5139a39de6a"],

Cell[TextData[{
 "Now we fix  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "0"], "\[LongEqual]", 
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["Q", "TI"], 
            StyleBox["C", "TI"], 
            StyleBox["D", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r_0=\\Lambda_{QCD}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c74f41e-93cd-db4b-8179-385cd9ec63c5"],
 " and we keep ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4f60d66-6e3a-4c49-9d16-415d0d327508"],
 " as a free parameter, and we plot it for several values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "362278ed-933f-a24c-91cc-9607d2467e6e"],
 " to see how much it changes."
}], "Text",
 CellChangeTimes->{{3.976455088467602*^9, 
  3.97645516957222*^9}},ExpressionUUID->"5116494e-56d5-ec45-af91-\
d77918744950"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"InverseFunction", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "Pi"}], ")"}]}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#2", "-", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#1", "/", "#3"}], "+", 
                RowBox[{"1", "/", "#2"}]}], ")"}]}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"#1", "+", 
             RowBox[{"#3", "/", "#2"}]}], ")"}]}], "+", 
          RowBox[{"#3", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"#1", "*", 
              RowBox[{"#2", "/", "#3"}]}], "+", "1"}], "]"}]}]}], ")"}]}], "-", 
       RowBox[{"1", "/", "2"}]}], "&"}], ",", "1", ",", "3"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{"#", " ", "&"}], ",", "5", ",", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"glabels", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<Proposed potential, with g=\>\"", ",", 
       RowBox[{"ToString", "[", "#", "]"}]}], " ", "]"}], "}"}], "&"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"labelsg", "=", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Array", "[", 
       RowBox[{"glabels", ",", "5", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.2"}], "}"}]}], "]"}], "]"}], 
     ",", "\"\<Lineal Potenital\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{
    RowBox[{"#", "/", "r0"}], " ", "&"}]}], ";"}], "\n", 
 RowBox[{"Array", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"DiscretePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"M", "[", 
          RowBox[{"x", ",", "r0", ",", "#"}], "]"}], "^", "2"}], ",", 
        RowBox[{"4", 
         RowBox[{"sigma", "[", "#", "]"}], "*", "Pi", 
         RowBox[{"(", 
          RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "5"}], "}"}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Proposed potential\>\"", 
         ",", "\"\<Linear Potential\>\""}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"n\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \"n\
\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", 
         ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SuperscriptBox[
StyleBox[\"M\", \"TI\"], \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"M^2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)[\!\
\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"\"\<Proposed potential, with g=\>\"", ",", 
         RowBox[{"ToString", "[", "#", "]"}]}], "]"}]}]}], "]"}], "&"}], ",", 
   "5", ",", 
   RowBox[{"{", 
    RowBox[{"0.01", ",", "0.2"}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{
