Cell[CellGroupData[{

Cell["\<\
Bohr-Sommerfeld semiclassical quantization taking into account the mass of \
the quarks\
\>", "Section",
 CellChangeTimes->{{3.972820160306278*^9, 3.9728201714256763`*^9}, {
  3.972820239664692*^9, 
  3.9728202559011707`*^9}},ExpressionUUID->"359fa8eb-2c90-eb4f-bf93-\
7f3a13950784"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9728204072494545`*^9, 
  3.9728204220104103`*^9}},ExpressionUUID->"0736fabd-6ff4-1e4c-961a-\
1f96bf0a7318"],

Cell[TextData[{
 "Now the new Hamiltonian in CM reference frame is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "+", 
            SubsuperscriptBox[
             StyleBox["m", "TI"], "1", "2"]}]], "+", 
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["p", "TI"], "2"], "+", 
            SubsuperscriptBox[
             StyleBox["m", "TI"], "2", "2"]}]], "+", "\[Sigma]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M=\\sqrt{p^2+m_1^2}+\\sqrt{p^2+m_2^2}+\\sigma r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b7b08a8-58d1-9e40-a483-1422b5c86ae4"],
 " "
}], "Text",
 CellChangeTimes->{{3.972887244861017*^9, 3.9728872637335453`*^9}, {
   3.9728873441999454`*^9, 3.97288735730377*^9}, 
   3.9728874270112286`*^9},ExpressionUUID->"60270442-3666-7d47-8ab8-\
ab6b31e51c15"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"InverseFunction", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "#2", "Pi"}], ")"}]}], " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "4"}], "-", 
              RowBox[{"2", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#3", "^", "2"}], "+", 
                 RowBox[{"#4", "^", "2"}]}], ")"}], 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#3", "^", "2"}], "+", 
                 RowBox[{"#4", "^", "2"}]}], ")"}], "^", "2"}], "-", 
              RowBox[{
               RowBox[{"#3", "^", "2"}], 
               RowBox[{"#4", "^", "2"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#3", "^", "2"}], "+", 
                RowBox[{"#4", "^", "2"}]}], ")"}]}], ")"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "#1", ",", 
            RowBox[{"(", 
             RowBox[{"#3", "+", "#4"}], ")"}]}], "}"}]}], "]"}]}], "-", 
       RowBox[{"1", "/", "2"}]}], "&"}], ",", "1", ",", "4"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sig", "=", 
   RowBox[{
    RowBox[{"139.57", "^", "2"}], "/", 
    RowBox[{"(", 
     RowBox[{"6", "Pi"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m1", "=", "2.16"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "=", "4.7"}], ";"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"x", ",", "sig", ",", "m1", ",", "m2"}], "]"}], "^", "2"}], ",", 
     RowBox[{"4", "sig", "*", "Pi", 
      RowBox[{"(", 
       RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Taking into acount the mass of the quarks.\>\"", 
      ",", "\"\<Without taking into account the mass of the quarks\>\""}], 
     "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"n\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \"n\
\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", 
      ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SuperscriptBox[
StyleBox[\"M\", \"TI\"], \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"M^2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)[\!\
\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\""}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"x", ",", "sig", ",", "m1", ",", "m2"}], "]"}], "^", "2"}], "-", 
       RowBox[{"4", "sig", "*", "Pi", 
        RowBox[{"(", 
         RowBox[{"x", "+", "0.5"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "sig", "*", "Pi", 
       RowBox[{"(", 
        RowBox[{"x", "+", "0.5"}], ")"}]}], ")"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "}"}]}],
   "]"}], "\n"}], "Code",
 CellChangeTimes->{{3.9728894785961704`*^9, 3.972889480425831*^9}, {
  3.972889716986164*^9, 3.972889834149349*^9}, {3.972889900489155*^9, 
