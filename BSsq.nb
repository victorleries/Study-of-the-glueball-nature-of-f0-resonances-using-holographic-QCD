Cell[CellGroupData[{

Cell["Cornell Potential", "Section",
 CellChangeTimes->{{3.9802199323514843`*^9, 
  3.980219936270462*^9}},ExpressionUUID->"bfa62b49-fc88-4946-9594-\
5e2beae49855"],

Cell[TextData[{
 "Now we use the following potential: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", "-", 
         FractionBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]], "+", "\[Sigma]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "V=-\\frac{A}{r}+\\sigma r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e18e2ce-88dc-554c-bd94-2da82384ff47"],
 ", i.e. a coulomb potential for higher energies (perturbative) and a string \
potential for lower energies (non perturbative). As the potential is \
divergent at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad74609d-1ca1-2c40-b6f4-6f87415bad88"],
 " we will use the minimum value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "651046d0-206a-8f4f-859b-4f2c6c2c9d9c"],
 " as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "r_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ba4c464-08a9-1c41-a355-457f86031faa"],
 ", as a new free parameter. Let\[CloseCurlyQuote]s obtain now the Regge \
trajectory."
}], "Text",
 CellChangeTimes->{{3.9802199449403553`*^9, 3.9802199621610947`*^9}, {
  3.9802200183631344`*^9, 3.980220052323635*^9}, {3.9802201225483246`*^9, 
  3.9802201774838104`*^9}, {3.980220215037567*^9, 3.9802202345426407`*^9}, {
  3.980220401613474*^9, 
  3.9802204852023525`*^9}},ExpressionUUID->"24af33b2-4c23-4a41-a738-\
c132f52c2feb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"InverseFunction", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#1", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "/", "#2"}], 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"4", "#2", "#3"}], ")"}], "/", 
                  RowBox[{"#1", "^", "2"}]}]}], "]"}]}], ")"}]}], "-", "#4"}],
            ")"}]}], "-", 
         RowBox[{"#3", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"#1", "/", 
             RowBox[{"(", 
              RowBox[{"#2", "#4"}], ")"}]}], 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"4", "#2", "#3"}], ")"}], "/", 
                 RowBox[{"#1", "^", "2"}]}]}], "]"}]}], ")"}]}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"#2", "/", "2"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#1", "/", "#2"}], 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "+", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"4", "#2", "#3"}], ")"}], "/", 
                    RowBox[{"#1", "^", "2"}]}]}], "]"}]}], ")"}]}], ")"}], "^",
              "2"}], "-", 
            RowBox[{"#4", "^", "2"}]}], ")"}]}]}], ")"}]}], "&"}], ",", "1", ",",
      "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", 
   RowBox[{"1", "/", "100000000000000000000"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"RandomReal", "[", "]"}]}], ";"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"x", ",", "sigma", ",", "A", ",", "r0"}], "]"}], "^", "2"}], ",", 
     RowBox[{"4", "sigma", "*", "Pi", 
      RowBox[{"(", 
       RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Proposed potential\>\"", ",", "\"\<Linear Potential\>\""}], 
     "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"n\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \"n\
\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", 
      ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SuperscriptBox[
StyleBox[\"M\", \"TI\"], \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"M^2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)[\!\
\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\""}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"x", ",", "sigma", ",", "A", ",", "r0"}], "]"}], "^", "2"}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", "\"\<Proposed potential\>\"", "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
StyleBox[\"n\", \"TI\"], TraditionalForm], \"errors\" -> {}, \"input\" -> \"n\
\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", 
      ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SuperscriptBox[
StyleBox[\"M\", \"TI\"], \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"M^2\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)[\!\
\(\*SuperscriptBox[\(MeV\), \(2\)]\)]\>\""}], "}"}]}]}], "]"}]}], "Code",
