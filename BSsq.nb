cb5ce9e9f9de"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"M", "=", 
  RowBox[{"InverseFunction", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#2", "-", 
            RowBox[{"1", "/", "#2"}], "-", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#1", "/", "#3"}], "+", 
               RowBox[{"1", "/", "#2"}]}], ")"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"#1", "+", 
            RowBox[{"#3", "/", "#2"}]}], ")"}]}], "+", 
         RowBox[{"#3", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#2", "-", 
              RowBox[{"1", "/", "#2"}]}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"#1", "/", "#3"}], ")"}]}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"1", "/", "2"}]}], "&"}], ",", "1", ",", "3"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"RandomReal", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", 
   RowBox[{"RandomReal", "[", "10", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"g", "/", "r0"}]}], ";"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"x", ",", "r0", ",", "g"}], "]"}], "^", "2"}], ",", 
     RowBox[{"4", "sigma", "*", "Pi", 
      RowBox[{"(", 
       RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
