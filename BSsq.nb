Cell[CellGroupData[{

Cell["General potential with lower bound for r ", "Section",
 CellChangeTimes->{{3.9757357395340824`*^9, 
  3.9757357635424385`*^9}},ExpressionUUID->"78504c85-fb43-334f-a387-\
e251aadf40c8"],

Cell[TextData[{
 "We take now the lower bound for r as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "min"], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox[
           StyleBox["r", "TI"], "0"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{min}}=\\frac{1}{r_0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ddea827d-9e9e-5f4f-a1ea-ff00a8e526bc"],
 "."
