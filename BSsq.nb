Cell[CellGroupData[{

Cell["General Potential renormalized", "Section",
 CellChangeTimes->{{3.9749595300911636`*^9, 
  3.974959538809765*^9}},ExpressionUUID->"05c1be05-7053-cb46-8fa6-\
02fc7b9e8d95"],

Cell[TextData[{
 "We try renormalizing by taking the potential at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", 
              RowBox[{
                StyleBox["r", "TI"], "-", 
                SubscriptBox[
                 StyleBox["r", "TI"], "0"], "+", "\[Epsilon]"}]], "-", 
             FractionBox["1", 
              SubscriptBox[
               StyleBox["r", "TI"], "0"]], 
             RowBox[{")", "\[Null]"}]}]}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "V(r)=g\\biggl(\\frac{1}{r-r_0+\\epsilon}-\\frac{1}{r_0}\\biggl)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e7ae0cd-8a8e-ea44-9b22-f8872b735585"],
 " and then taking the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       UnderscriptBox["lim", 
        RowBox[{"\[Epsilon]", "\[Rule]", "0"}], LimitsPositioning -> True], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\lim_{\\epsilon\\rightarrow 0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c990ef4-7c6d-4045-b95e-a58e859c8640"],
 " of the result."
}], "Text",
 CellChangeTimes->{{3.9749595693092823`*^9, 3.974959576257023*^9}, {
  3.974959743990925*^9, 3.974959755761488*^9}, {3.974959826462166*^9, 
  3.974959838067913*^9}, {3.9749598724019356`*^9, 
  3.9749598746957054`*^9}},ExpressionUUID->"583d1c82-93fa-7b4c-8083-\
4bdad7f31705"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"M", "=", 
  RowBox[{"InverseFunction", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi"}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#2", "-", "#4", "-", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#1", "/", "#3"}], "+", 
               RowBox[{"1", "/", "#2"}]}], ")"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"#1", "+", 
            RowBox[{"#3", "/", "#2"}]}], ")"}]}], "+", 
         RowBox[{"#3", 
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#1", "/", "#3"}], "+", 
              RowBox[{"1", "/", "#2"}]}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"#2", "-", "#4"}], ")"}]}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"1", "/", "2"}]}], "&"}], ",", "1", ",", "4"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"RandomReal", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r0", "=", 
   RowBox[{"RandomReal", "[", "10", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"g", "/", "r0"}]}], ";"}], "\n", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"M", "[", 
       RowBox[{"x", ",", "r0", ",", "g", ",", "0"}], "]"}], "^", "2"}], ",", 
     RowBox[{"4", "sigma", "*", "Pi", 
      RowBox[{"(", 
       RowBox[{"x", "+", "0.5"}], ")"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Proposed potential\>\"", ",", "\"\<Linear Potential\>\""}], 
     "}"}]}]}], "]"}]}], "Code",
