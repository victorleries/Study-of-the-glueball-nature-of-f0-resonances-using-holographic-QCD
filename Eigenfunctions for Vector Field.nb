         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            SqrtBox["2"]}]}], ")"}]}]], " ", 
       SuperscriptBox["\[ExponentialE]", 
