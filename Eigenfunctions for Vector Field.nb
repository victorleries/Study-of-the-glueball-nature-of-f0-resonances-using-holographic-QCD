Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Psi]", "[", "z", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "2"]}], " ", 
         SuperscriptBox["z", "2"], " ", 
         SuperscriptBox["\[Lambda]", "2"]}]], " ", 
       TemplateBox[{"1"},
        "C"], " ", 
       RowBox[{"HypergeometricU", "[", 
