Cell[CellGroupData[{
Cell["\<\
Check of the result of \[OpenCurlyDoubleQuote]Hadron physics in holographic \
QCD\[CloseCurlyDoubleQuote] equation (94)\
\>", "Section",
 CellChangeTimes->{{3.9729005223544426`*^9, 3.972900535700796*^9}, {
  3.972900577991642*^9, 3.9729005881694775`*^9}, {3.972901006653162*^9, 
  3.972901009165367*^9}},ExpressionUUID->"4bf34559-504c-da45-bebf-\
4065c0c51801"],

Cell[TextData[{
 "We must see that the eigenvalues of the function are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["M", "TI"], "2"], "\[LongEqual]", "4", 
         SuperscriptBox["\[Lambda]", "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "+", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "M^2=4\\lambda^2(n+1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89abb20f-4be0-9143-9e84-8f0e18b62fb7"],
 ". Let\[CloseCurlyQuote]s first do it for the solution I found."
}], "Text",
 CellChangeTimes->{{3.9729012385456867`*^9, 3.9729012656909027`*^9}, {
  3.972901453499773*^9, 
  3.972901474578169*^9}},ExpressionUUID->"ace53432-1ab7-d94e-990e-\
3d935cf06e6f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"\[Psi]", "''"}], "[", "z", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "/", 
         RowBox[{"(", 
          RowBox[{"4", 
           RowBox[{"z", "^", "2"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"\[Lambda]", "^", "4"}], 
         RowBox[{"z", "^", "2"}]}]}], ")"}], 
      RowBox[{"\[Psi]", "[", "z", "]"}]}]}], "==", 
    RowBox[{
     RowBox[{"m", "^", "2"}], 
     RowBox[{"\[Psi]", "[", "z", "]"}]}]}], ",", 
   RowBox[{"\[Psi]", "[", "z", "]"}], ",", "z"}], "]"}], "\n", 
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "z", "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "/", 
         RowBox[{"(", 
          RowBox[{"4", 
           RowBox[{"z", "^", "2"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"\[Lambda]", "^", "4"}], 
         RowBox[{"z", "^", "2"}]}]}], ")"}], 
      RowBox[{"\[Psi]", "[", "z", "]"}]}]}], "==", 
    RowBox[{
     RowBox[{"m", "^", "2"}], 
     RowBox[{"\[Psi]", "[", "z", "]"}]}]}], ",", 
   RowBox[{"\[Psi]", "[", "z", "]"}], ",", "z"}], "]"}]}], "Code",
 CellChangeTimes->{{3.9729012238058987`*^9, 3.9729012274203415`*^9}, 
   3.9729013839889164`*^9, {3.972901428048521*^9, 3.9729014460971737`*^9}, {
