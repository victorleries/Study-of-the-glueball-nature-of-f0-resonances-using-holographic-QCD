          RowBox[{"4", " ", 
           SuperscriptBox["\[Lambda]", "2"]}]], ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{
          SuperscriptBox["z", "2"], " ", 
          SuperscriptBox["\[Lambda]", "2"]}]}], "]"}]}], 
      SqrtBox["z"]]}]}], "}"}], "}"}]], "Output",
