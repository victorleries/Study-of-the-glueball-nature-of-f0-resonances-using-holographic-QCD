          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              SqrtBox["2"]}]}], ")"}]}]}], ",", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SuperscriptBox["z", "2"], " ", 
          SuperscriptBox["\[Lambda]", "2"]}]}], "]"}]}], 
      SqrtBox["z"]]}]}], "}"}], "}"}]], "Output",
