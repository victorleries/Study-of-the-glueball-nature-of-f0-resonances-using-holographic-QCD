         FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
         SuperscriptBox["z", "2"], " ", 
         SuperscriptBox["\[Lambda]", "2"]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["z", "2"], ")"}], 
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            SqrtBox["2"]}]}], ")"}]}]], " ", 
       TemplateBox[{"2"},
        "C"], " ", 
       RowBox[{"LaguerreL", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["m", "2"], "-", 
              RowBox[{"2", " ", "\[ImaginaryI]", " ", 
