Cell["\<\
Let\[CloseCurlyQuote]s restrict it a bit more and see if there are any \
trajectory that has all parameters that have to be positive already positive.\
\>", "Text",
 CellChangeTimes->{{3.988126994144493*^9, 3.9881270312627106`*^9}, {
  3.98812722945068*^9, 
  3.9881272374400654`*^9}},ExpressionUUID->"45aa7a36-2336-3640-9268-\
79eb895af55f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"signs", "=", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "To", " ", "get", " ", "the", " ", "signs", " ", "of", " ", "the", " ", 
    "interesting", " ", "solutions"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "to", " ", "count", " ", "the", " ", "ammount", " ", "of", " ", 
    "interesting", " ", "arrangements"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"res\[Sigma]", "=", 
    RowBox[{"{", "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "To", " ", "store", " ", "the", " ", "residues", " ", "of", " ", "the", " ",
     "prediction", " ", "for", " ", "the", " ", "sigma"}], "*)"}]}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "trajectories", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"trajectories", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"\[Delta]m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"nd", "=", 
     RowBox[{"{", "0", "}"}]}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", 
       RowBox[{"Length", "[", "m", "]"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "j", "]"}], ",", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"nd", ",", "j"}], "]"}], ",", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"nd", ",", 
          RowBox[{"j", "+", "2"}]}], "]"}]}], "]"}]}], "\n", "\t", "]"}], ";",
     "\n", "\t", 
    RowBox[{"m", "=", 
