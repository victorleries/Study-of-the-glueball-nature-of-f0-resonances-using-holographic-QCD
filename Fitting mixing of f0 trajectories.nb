Cell[TextData[{
 "Now let\[CloseCurlyQuote]s do the fit for every arrangement of \
trajectories. And let\[CloseCurlyQuote]s keep what interest us that will be: \
\n\t- Fitted function\n\t- Best fit parameters\n\t- Covariance Matrix\n\t- \
Some goodness of fit value?\n\t- Distance of the next mass of each trajectory \
to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "58c92091-456d-1a44-b374-50afe61dfd75"],
 "(2330)"
}], "Text",
 CellChangeTimes->{{3.9870708498721313`*^9, 3.9870708934795856`*^9}, {
