Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.23", ",", "0.980", ",", "2.19", ",", "3.92", ",", "4.78", ",", "1.81", 
     ",", "3.06", ",", "4.38", ",", "5.46"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.13", ",", "0.099", ",", "0.0096", ",", "0.87", ",", "0.46", ",", 
     "0.24", ",", "0.20", ",", "0.61", ",", "0.41"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masseswith\[Delta]", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"masses", ",", "i"}], "]"}], ",", 
        RowBox[{"Extract", "[", 
         RowBox[{"\[Delta]masses", ",", "i"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "masses", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Definie", " ", "the", " ", "masses", " ", "their", " ", 
    RowBox[{"errors", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permmasses", "=", 
    RowBox[{"Permutations", "[", "masseswith\[Delta]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Get", " ", "all", " ", "the", " ", "permutations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"trajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "permmasses", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", 
    RowBox[{
    "Organise", " ", "the", " ", "permutations", " ", "in", " ", "order", " ",
      "tot", " ", "get", " ", "the", " ", "two", " ", "trajectories"}], 
    "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"m1", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m2", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"4", ";;", "6"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m3", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"7", ";;", 
          RowBox[{"Length", "[", "masseswith\[Delta]", "]"}]}], "]"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory1", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory2", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory3", "=", 
