Cell["Now let\[CloseCurlyQuote]s filter the value of \[Mu]", "Text",
 CellChangeTimes->{{3.9883884171577816`*^9, 
  3.988388436495371*^9}},ExpressionUUID->"96da1756-1779-6c48-b234-\
6b5748856502"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "to", " ", "count", " ", "the", " ", "number", " ", "of", " ", 
    "reasonable", " ", "trajectories"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"bettertajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "goodtrajectories", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"goodtrajectories", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"\[Delta]m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"m", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{
          RowBox[{"Length", "[", "m", "]"}], "-", "1"}], ",", "1"}], "}"}]}], 
      "]"}]}], ";", "\n", "\t", 
    RowBox[{"fit", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"m", ",", "h", ",", 
       RowBox[{"{", 
        RowBox[{
        "m02", ",", "m02s", ",", "m02p", ",", "\[Mu]p", ",", "\[Mu]", ",", 
         "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], ",", "n", ",", 
       RowBox[{"Weights", "->", 
        RowBox[{"1", "/", 
         RowBox[{"\[Delta]m", "^", "2"}]}]}]}], "]"}]}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Fit", " ", "parameters", " ", "to", " ", "data", " ", "and", " ", 
      "print", " ", "relevant", " ", "info"}], "*)"}], "\n", "\t", 
    RowBox[{"slope", "=", 
     RowBox[{
      RowBox[{"{", "\[Mu]", "}"}], "/.", 
      RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";", "\n", 
    "\t", 
    RowBox[{"slope", "=", 
     RowBox[{"slope", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"1.3", "\[LessEqual]", "slope", "\[LessEqual]", "1.56"}], ",", 
      "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"bettertajectories", ",", "M"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"bestfitparams", "=", 
        RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", "\n", 
       "\t\t", 
       RowBox[{"bestfitmas", "=", "M"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 1\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Print", " ", "trajectories"}], "*)"}], " ", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 2\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 3\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "4", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"Normal", "[", "fit", "]"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "]"}],
        ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], 
       ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SuperscriptBox[\(R\), \(2\)]\)=\>\"", ",", 
         RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";", "\n", 
       "\t\t", 
       RowBox[{"t", "=", 
        RowBox[{"t", "+", "1"}]}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"fit", "[", "\"\<FitResiduals\>\"", "]"}], "]"}]}]}], "\n", 
     "\t", "]"}], ";"}]}], "\n", "]"}], "\n", "t"}], "Code",
