    RowBox[{"mf2", "=", "l"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Delta]mf2", "=", "\[Delta]l"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mf2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
