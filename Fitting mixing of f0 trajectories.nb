Cell[TextData[{
 "We see that the original mass of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s\\overline s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9673ddc-776f-4341-b1cf-5d09a72b636f"],
 " is lower than for light-quarks, but in fact it\[CloseCurlyQuote]s just a \
relabel, as the slope is the same. So no problem :)"
}], "Text",
 CellChangeTimes->{{3.988278969210457*^9, 
  3.9882790379279556`*^9}},ExpressionUUID->"d88bd8d0-5511-444a-b2be-\
6e8c0fff669a"],

