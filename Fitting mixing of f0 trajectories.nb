Cell["Now let\[CloseCurlyQuote]s do it for all possible arrangements.", "Text",
 CellChangeTimes->{{3.9870607901740456`*^9, 3.9870607970844593`*^9}, {
  3.987061008477764*^9, 
  3.98706101617441*^9}},ExpressionUUID->"9a24bba9-ab2a-3547-b5af-\
