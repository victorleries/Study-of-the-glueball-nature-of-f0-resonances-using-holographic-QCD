201d114ba34b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"signs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "To", " ", "get", " ", "the", " ", "signs", " ", "of", " ", "the", " ", 
    "interesting", " ", "solutions"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "to", " ", "count", " ", "the", " ", "ammount", " ", "of", " ", 
    "interesting", " ", "arrangements"}], "*)"}]}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "trajectories", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"trajectories", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"\[Delta]m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m", ",", 
           RowBox[{"i", "+", "1"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{
          RowBox[{"Length", "[", "m", "]"}], "-", "1"}], ",", "1"}], "}"}]}], 
      "]"}]}], ";", "\n", "\t", 
    RowBox[{"fit", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"m", ",", "f", ",", 
       RowBox[{"{", 
        RowBox[{
        "m02", ",", "m02p", ",", "\[Mu]p", ",", "\[Theta]", ",", "\[Mu]"}], 
        "}"}], ",", "n", ",", 
       RowBox[{"Weights", "->", 
        RowBox[{"1", "/", 
         RowBox[{"\[Delta]m", "^", "2"}]}]}]}], "]"}]}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Fit", " ", "parameters", " ", "to", " ", "data", " ", "and", " ", 
      "print", " ", "relevant", " ", "info"}], "*)"}], "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MemberQ", "[", 
       RowBox[{"signs", ",", "sign"}], "]"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 1\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2", ",", 
              RowBox[{"Length", "[", "m", "]"}], ",", "2"}], "}"}]}], "]"}]}],
          "}"}], "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Print", " ", "trajectories"}], "*)"}], " ", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 2\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3", ",", 
              RowBox[{"Length", "[", "m", "]"}], ",", "2"}], "}"}]}], "]"}]}],
          "}"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"Normal", "[", "fit", "]"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "]"}],
        ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], 
       ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SuperscriptBox[\(R\), \(2\)]\)=\>\"", ",", 
         RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";", "\n", 
       "\t\t", 
       RowBox[{"t", "=", 
        RowBox[{"t", "+", "1"}]}]}]}], "]"}]}]}], "\n", 
  "]"}], "\n", "t"}], "Code",
