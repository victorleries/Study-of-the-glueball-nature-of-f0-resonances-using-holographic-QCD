   RowBox[{"{", 
    RowBox[{"0.24", ",", "0.20", ",", "0.61", ",", "0.41"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m02", "+", 
      RowBox[{"\[Mu]", "*", "n"}]}], ",", 
     RowBox[{"m02p", "+", 
      RowBox[{"\[Mu]p", "*", "n"}]}]}], "}"}]}], ";"}]}], "Code",
