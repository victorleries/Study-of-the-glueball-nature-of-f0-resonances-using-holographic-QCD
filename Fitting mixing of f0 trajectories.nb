Cell[TextData[{
 "Now let\[CloseCurlyQuote]s filter the trajectories that give reasonable \
values of \[Mu]. Up to 3 sigma difference from the original slope of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3469ac0d-0588-f842-996f-e2cfbfb5a28b"],
 " mesons."
}], "Text",
 CellChangeTimes->{{3.98817629124329*^9, 3.988176312707838*^9}, {
  3.988278608006548*^9, 3.988278612935766*^9}, {3.988278720544771*^9, 
  3.988278749295292*^9}},ExpressionUUID->"06cb2950-e299-3445-b341-\
240a4b36edcd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "to", " ", "count", " ", "the", " ", "number", " ", "of", " ", 
    "reasonable", " ", "trajectories"}], "*)"}]}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "goodtrajectories", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"goodtrajectories", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"\[Delta]m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"m", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{
          RowBox[{"Length", "[", "m", "]"}], "-", "1"}], ",", "1"}], "}"}]}], 
      "]"}]}], ";", "\n", "\t", 
    RowBox[{"fit", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"m", ",", "h", ",", 
       RowBox[{"{", 
        RowBox[{
        "m02", ",", "m02s", ",", "m02p", ",", "\[Mu]p", ",", "\[Mu]", ",", 
         "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], ",", "n", ",", 
       RowBox[{"Weights", "->", 
        RowBox[{"1", "/", 
         RowBox[{"\[Delta]m", "^", "2"}]}]}]}], "]"}]}], ";", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Fit", " ", "parameters", " ", "to", " ", "data", " ", "and", " ", 
      "print", " ", "relevant", " ", "info"}], "*)"}], "\n", "\t", 
    RowBox[{"slope", "=", 
     RowBox[{
      RowBox[{"{", "\[Mu]", "}"}], "/.", 
      RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";", "\n", 
    "\t", 
    RowBox[{"slope", "=", 
     RowBox[{"slope", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"1.04", "\[LessEqual]", "slope", "\[LessEqual]", "1.82"}], ",", 
      "\n", "\t\t", 
      RowBox[{
       RowBox[{"bestfitparams", "=", 
        RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", "\n", 
       "\t\t", 
       RowBox[{"bestfitmas", "=", "M"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 1\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Print", " ", "trajectories"}], "*)"}], " ", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 2\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Trajectory 3\>\"", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "4", ",", 
              RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], 
           "]"}]}], "}"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"Normal", "[", "fit", "]"}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "]"}],
        ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], 
       ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SuperscriptBox[\(R\), \(2\)]\)=\>\"", ",", 
         RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";", "\n", 
       "\t\t", 
       RowBox[{"t", "=", 
        RowBox[{"t", "+", "1"}]}], ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"fit", "[", "\"\<FitResiduals\>\"", "]"}], "]"}]}]}], "\n", 
     "\t", "]"}], ";"}]}], "\n", "]"}], "\n", "t"}], "Code",
