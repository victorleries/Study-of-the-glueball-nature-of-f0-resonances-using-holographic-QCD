Cell[BoxData[{
 RowBox[{
  RowBox[{"m1f2", "=", 
   RowBox[{"{", 
    RowBox[{"0.980", ",", "2.19", ",", "3.92", ",", "4.78"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"m2f2", "=", 
   RowBox[{"{", 
    RowBox[{"1.81", ",", "3.06", ",", "4.38", ",", "5.46"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]m1f2", "=", 
   RowBox[{"{", 
    RowBox[{"0.099", ",", "0.0096", ",", "0.87", ",", "0.46"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
