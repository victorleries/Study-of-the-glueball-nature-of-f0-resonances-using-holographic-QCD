       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory6", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectory1"}], "]"}], "==", "False"}],
        "&&", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectory2"}], "]"}], "==", "False"}],
