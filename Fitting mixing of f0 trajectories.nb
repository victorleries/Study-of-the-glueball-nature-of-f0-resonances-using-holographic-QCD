Notebook[{

Cell[CellGroupData[{
Cell["Fitting model to the data", "Title",
 CellChangeTimes->{{3.986619534013893*^9, 
  3.9866195395620728`*^9}},ExpressionUUID->"77ddf9e4-5930-bc45-9147-\
1179afdb9627"],

Cell[TextData[{
 "Now let\[CloseCurlyQuote]s fir the data to the model instead of solving a \
system of equations, thus giving us smaller uncertainties. We will do it \
first for one arrangement for the real trajectories and then for all \
arrangements. Both for considering 2 trajectories: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c8ce44d-dd19-9a4b-9364-4d9e4edb44ba"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\.08", 
         SuperscriptBox[
          StyleBox["G", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\.08G^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3cd77b1-43ce-f547-8389-6e9bb63e0587"],
 ", and then for 3 trajectories: light ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3a71303-ccc6-0946-94c7-c5f3d488cd41"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s\\overline s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "70d95e25-25c7-5944-a3dc-e59f9d02b3bc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\.08", 
         SuperscriptBox[
          StyleBox["G", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\.08G^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c85f1986-4ce7-7b4e-b71c-2a812af39e12"],
 "."
}], "Text",
 CellChangeTimes->{{3.9866196102929363`*^9, 3.986619640720234*^9}, {
