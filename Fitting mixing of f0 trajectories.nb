Cell[TextData[{
 "Let\[CloseCurlyQuote]s get the last one as is the one with the highest ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9cc3de3f-4e97-0a4a-b153-bc1c96fb5a01"],
 "."
}], "Text",
