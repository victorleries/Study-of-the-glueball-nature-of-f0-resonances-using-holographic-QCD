Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"First", " ", 
    RowBox[{"let", "'"}], "s", " ", "introducte", " ", "the", " ", "data", " ",
     "and", " ", "generate", " ", "one", " ", "sample", " ", "arrangement"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mf2", "=", 
     RowBox[{"{", 
      RowBox[{
      "0.980", ",", "2.19", ",", "3.92", ",", "4.78", ",", "1.81", ",", 
       "3.06", ",", "4.38", ",", "5.46", ",", "0.23"}], "}"}]}], ";"}], "\n", 
   RowBox[{
