29c207e2c11e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MaximalBy", "[", "Last", "]"}], "[", "classification", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"M", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]m", "=", 
   RowBox[{"M", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"m", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{
        RowBox[{"Length", "[", "m", "]"}], "-", "1"}], ",", "1"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fit", "=", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"m", ",", "h", ",", 
      RowBox[{"{", 
       RowBox[{
       "m02", ",", "m02s", ",", "m02p", ",", "\[Mu]p", ",", "\[Mu]", ",", 
        "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], ",", "n", ",", 
      RowBox[{"Weights", "->", 
       RowBox[{"1", "/", 
        RowBox[{"\[Delta]m", "^", "2"}]}]}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Fit", " ", "parameters", " ", "to", " ", "data", " ", "and", " ", "print",
     " ", "relevant", " ", "info"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Trajectory 1\>\"", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"m", "[", 
         RowBox[{"[", "j", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2", ",", 
          RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], "]"}]}], 
     "}"}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "trajectories"}], "*)"}], " "}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Trajectory 2\>\"", ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3", ",", 
         RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], "]"}]}], 
    "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Trajectory 3\>\"", ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"m", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "4", ",", 
         RowBox[{"Length", "[", "mf2", "]"}], ",", "3"}], "}"}]}], "]"}]}], 
    "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Normal", "[", "fit", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\!\(\*SuperscriptBox[\(R\), \(2\)]\)=\>\"", ",", 
    RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";"}], "\n", 
