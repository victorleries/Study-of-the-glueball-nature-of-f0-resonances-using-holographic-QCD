Cell[CellGroupData[{

Cell["Now with less masses", "Subsubsection",
 CellChangeTimes->{{3.9873237684042664`*^9, 3.98732377166638*^9}, {
  3.987323824636116*^9, 
  3.9873238247960587`*^9}},ExpressionUUID->"bc3a6805-557e-dd41-8e56-\
b81a0dd698be"],

Cell["\<\
Now instead of putting the 8 lightest masses let\[CloseCurlyQuote]s use the 6 \
lightest and sacrificing precession but let\[CloseCurlyQuote]s add more \
freedom to see if we obtain a solution with every of the parameters that have \
to be positive to be that way. And then if they predict more or less \
successfully the next masses. Let\[CloseCurlyQuote]s first create the \
arrangements:\
\>", "Text",
 CellChangeTimes->{{3.987323831351969*^9, 3.9873238844415665`*^9}, {
  3.987323987641424*^9, 3.9873240060411415`*^9}, {3.987324076949354*^9, 
  3.9873241421146736`*^9}, {3.98732420120545*^9, 3.987324220568651*^9}, {
  3.987324721614395*^9, 
  3.9873247336034164`*^9}},ExpressionUUID->"d66cfea5-f34e-3140-ba7e-\
4f68c9214f9a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.23", ",", "0.980", ",", "2.19", ",", "3.92", ",", "1.81", ",", 
     "3.06"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.13", ",", "0.099", ",", "0.0096", ",", "0.87", ",", "0.24", ",", 
     "0.20"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masseswith\[Delta]", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"masses", ",", "i"}], "]"}], ",", 
        RowBox[{"Extract", "[", 
         RowBox[{"\[Delta]masses", ",", "i"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "masses", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Definie", " ", "the", " ", "masses", " ", "their", " ", 
    RowBox[{"errors", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permmasses", "=", 
    RowBox[{"Permutations", "[", "masseswith\[Delta]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Get", " ", "all", " ", "the", " ", "permutations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"trajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "permmasses", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", 
    RowBox[{
    "Organise", " ", "the", " ", "permutations", " ", "in", " ", "order", " ",
      "tot", " ", "get", " ", "the", " ", "two", " ", "trajectories"}], 
    "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"m1", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m2", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"4", ";;", 
          RowBox[{"Length", "[", "masseswith\[Delta]", "]"}]}], "]"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", "\n", "\t", 
    RowBox[{"trajectoryp", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"to", " ", "avoid", " ", "double", " ", "couting"}], "*)"}], 
    "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "3"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "3"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectoryp", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectoryp", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectory"}], "]"}], "==", "False"}], 
       "&&", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectoryp"}], "]"}], "==", 
        "False"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"trajectories", ",", "trajectory"}], "]"}]}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "with", " ", "this", " ", "method", " ", "we", " ", "get", " ", 
     "repeated", " ", "arranges"}], ",", " ", 
    RowBox[{"so", " ", 
     RowBox[{"let", "'"}], "s", " ", "keep", " ", "them", " ", "only", " ", 
     "if", " ", "they", " ", "are", " ", "no", " ", "already", " ", "there", " ",
      "or", " ", "an", " ", "equivalent", " ", "arrangement", " ", "is", " ", 
     "already", " ", "there"}]}], "*)"}], "\n", "]"}], "\n", 
 RowBox[{"Length", "[", "trajectories", "]"}]}], "Code",
 CellChangeTimes->{{3.987324759124901*^9, 3.98732476656645*^9}, {
  3.9873248484041233`*^9, 3.9873249394117317`*^9}, {3.987325069021124*^9, 
