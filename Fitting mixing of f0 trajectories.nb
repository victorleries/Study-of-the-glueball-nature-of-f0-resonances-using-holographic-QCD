Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"Extract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", "\[Theta]", "]"}], ".", "v"}], ",", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"f1", "[", "n_", "]"}], "=", "g1"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"Extract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", "\[Theta]", "]"}], ".", "v"}], ",", 
     "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"f2", "[", "n_", "]"}], "=", "g2"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f1", "[", 
          FractionBox[
           RowBox[{"n", "+", "1"}], "2"], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", "2"}], "]"}], "==", "1"}], "&&", 
          RowBox[{"n", ">", "0"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f2", "[", 
          FractionBox["n", "2"], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", "2"}], "]"}], "==", "0"}], "&&", 
          RowBox[{"n", ">", "0"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", 
         RowBox[{"n", "==", "0"}]}], "}"}]}], "}"}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "a", " ", "picewise", " ", "function", " ", "where", " ", 
     "masses", " ", "of", " ", "1", "st", " ", "trajectory", " ", "are", " ", 
     "put", " ", "in", " ", "odd", " ", "values", " ", "and", " ", "the", " ",
      "masses", " ", "of", " ", "the", " ", "2", "nd", " ", "trajectory", " ",
      "in", " ", "even", " ", "values", " ", "and", " ", "set", " ", "at", " ",
      "n"}], "=", 
    RowBox[{
    "0", " ", "\[Mu]p", " ", "so", " ", "we", " ", "can", " ", "add", " ", 
     RowBox[{"it", "'"}], "s", " ", "error"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mf2", "=", 
    RowBox[{"{", "1.43", "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Organise", " ", "both", " ", "trajectories", " ", "in", " ", "onw", " ", 
    "list", " ", "with", " ", "odd", " ", "possitions", " ", "for", " ", 
    "trajectory", " ", "1", " ", "and", " ", "even", " ", "possitions", " ", 
    "for", " ", "trajectory", " ", "2"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]mf2", "=", 
   RowBox[{"{", "0.13", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "m1f2", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"mf2", ",", 
      RowBox[{"Extract", "[", 
       RowBox[{"m1f2", ",", "i"}], "]"}]}], "]"}], ";", "\n", "\t", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"mf2", ",", 
      RowBox[{"Extract", "[", 
       RowBox[{"m2f2", ",", "i"}], "]"}]}], "]"}], ";", "\n", "\t", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"\[Delta]mf2", ",", 
      RowBox[{"Extract", "[", 
       RowBox[{"\[Delta]m1f2", ",", "i"}], "]"}]}], "]"}], ";", "\n", "\t", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"\[Delta]mf2", ",", 
      RowBox[{"Extract", "[", 
       RowBox[{"\[Delta]m2f2", ",", "i"}], "]"}]}], "]"}]}]}], "\n", "]"}], "\n", 
 RowBox[{"mf2", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Extract", "[", 
       RowBox[{"mf2", ",", 
        RowBox[{"i", "+", "1"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "mf2", "]"}], "-", "1"}], ",", "1"}], "}"}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fit", "=", 
    RowBox[{"NonlinearModelFit", "[", 
     RowBox[{"mf2", ",", "f", ",", 
      RowBox[{"{", 
       RowBox[{
       "m02", ",", "m02p", ",", "\[Mu]p", ",", "\[Theta]", ",", "\[Mu]"}], 
       "}"}], ",", "n", ",", 
      RowBox[{"Weights", "->", 
       RowBox[{"1", "/", 
        RowBox[{"\[Delta]mf2", "^", "2"}]}]}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Fit", " ", "parameters", " ", "to", " ", "data", " ", "and", " ", "print",
     " ", "relevant", " ", "info"}], "*)"}]}], "\n", 
 RowBox[{"Normal", "[", "fit", "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}]}], "Code",
