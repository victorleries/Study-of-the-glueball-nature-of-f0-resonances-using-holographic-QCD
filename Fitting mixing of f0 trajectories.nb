Cell[CellGroupData[{

Cell["Two trajectories", "Subsection",
 CellChangeTimes->{{3.9870610238626614`*^9, 
  3.9870610272699814`*^9}},ExpressionUUID->"44346ebc-f837-914b-a313-\
878e6240861c"],

Cell[TextData[{
 "For all possible arrangements let\[CloseCurlyQuote]s use the eight lightest \
masses and then see if the arrangement predicts the 9th mass, i.e ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b14b6ca-2bb2-3045-9c6f-49ea6ab0c337"],
 "(2330). Let\[CloseCurlyQuote]s first generate all the arrangements:"
}], "Text",
 CellChangeTimes->{{3.9870611133245487`*^9, 3.9870611561846237`*^9}, {
  3.9870612099179764`*^9, 3.9870612534913635`*^9}, {3.987061316710413*^9, 
  3.9870613433874454`*^9}, {3.9870613801446285`*^9, 
  3.987061385371952*^9}},ExpressionUUID->"c504938a-614e-994e-b6d6-\
e7657a059f4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.23", ",", "0.980", ",", "2.19", ",", "3.92", ",", "4.78", ",", "1.81", 
     ",", "3.06", ",", "4.38"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.13", ",", "0.099", ",", "0.0096", ",", "0.87", ",", "0.46", ",", 
     "0.24", ",", "0.20", ",", "0.61"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2f02330", "=", "5.46"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]m2f02330", "=", "0.41"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masseswith\[Delta]", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"masses", ",", "i"}], "]"}], ",", 
        RowBox[{"Extract", "[", 
         RowBox[{"\[Delta]masses", ",", "i"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "masses", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Definie", " ", "the", " ", "masses", " ", "their", " ", 
    RowBox[{"errors", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permmasses", "=", 
    RowBox[{"Permutations", "[", "masseswith\[Delta]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Get", " ", "all", " ", "the", " ", "permutations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"trajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "permmasses", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", 
    RowBox[{
    "Organise", " ", "the", " ", "permutations", " ", "in", " ", "order", " ",
      "tot", " ", "get", " ", "the", " ", "two", " ", "trajectories"}], 
    "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"m1", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "4"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m2", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;", 
          RowBox[{"Length", "[", "masseswith\[Delta]", "]"}]}], "]"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", "\n", "\t", 
    RowBox[{"trajectoryp", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"to", " ", "avoid", " ", "double", " ", "couting"}], "*)"}], 
    "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "4"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "4"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectoryp", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectoryp", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectory"}], "]"}], "==", "False"}], 
       "&&", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"trajectories", ",", "trajectoryp"}], "]"}], "==", 
        "False"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"trajectories", ",", "trajectory"}], "]"}]}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "with", " ", "this", " ", "method", " ", "we", " ", "get", " ", 
     "repeated", " ", "arranges"}], ",", " ", 
    RowBox[{"so", " ", 
     RowBox[{"let", "'"}], "s", " ", "keep", " ", "them", " ", "only", " ", 
     "if", " ", "they", " ", "are", " ", "no", " ", "already", " ", "there", " ",
      "or", " ", "an", " ", "equivalent", " ", "arrangement", " ", "is", " ", 
     "already", " ", "there"}]}], "*)"}], "\n", "]"}]}], "Code",
