   3.9879125187438736`*^9, 3.987933075636778*^9, 3.988015717525242*^9, 
   3.988017704692127*^9, 3.9881272830718327`*^9, 3.988127423318882*^9, 
   3.988176152774742*^9, 3.988190953552162*^9, 3.988277551915121*^9, 
