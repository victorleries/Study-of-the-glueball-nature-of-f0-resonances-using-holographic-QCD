     "]"}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "3"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory4", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory4", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m3", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
