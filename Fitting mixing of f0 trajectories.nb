   3.988190952695423*^9, 3.988277550847023*^9, 3.9882784027586174`*^9, 
   3.988376489882387*^9, 3.988376569477085*^9, 3.988388101388403*^9, 
   3.9883882012763996`*^9, 3.988607113820429*^9, 3.988607344914856*^9, 
