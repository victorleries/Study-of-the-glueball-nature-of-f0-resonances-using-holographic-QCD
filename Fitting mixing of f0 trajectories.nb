          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "3"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory3", ",", 
