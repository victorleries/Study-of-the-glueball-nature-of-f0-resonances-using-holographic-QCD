Cell["\<\
Not let\[CloseCurlyQuote]s see if there is a better solution for negative \
initial masses as the first we get is the one at n=1.\
\>", "Text",
 CellChangeTimes->{{3.9883866046349144`*^9, 
  3.988386633688751*^9}},ExpressionUUID->"d3766ae8-4a1f-c742-8dd2-\
e8e138684d1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"signs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", 
         RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "To", " ", "get", " ", "the", " ", "signs", " ", "of", " ", "the", " ", 
    "interesting", " ", "solutions"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", "0"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "to", " ", "count", " ", "the", " ", "number", " ", "of", " ", 
    "reasonable", " ", "trajectories"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"goodtrajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "trajectories", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"trajectories", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"\[Delta]m", "=", 
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
