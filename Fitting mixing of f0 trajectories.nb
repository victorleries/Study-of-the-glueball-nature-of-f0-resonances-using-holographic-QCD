Cell["\<\
Let\[CloseCurlyQuote]s get now the arrangement that get\[CloseCurlyQuote]s \
the first mass the closest to the sigma.\
\>", "Text",
 CellChangeTimes->{{3.9880187591286793`*^9, 3.9880187633602867`*^9}, {
  3.988018833173189*^9, 3.9880188356405735`*^9}, {3.9880189028250523`*^9, 
  3.9880189260655518`*^9}},ExpressionUUID->"085b3d0e-f67e-6540-999b-\
aeab9c679ed7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"minres", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"MinimalBy", "[", 
      RowBox[{"res\[Sigma]", ",", "Last"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Obtain", " ", "the", " ", "optimal", " ", "arrangement"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"minm", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MinimalBy", "[", 
       RowBox[{"res\[Sigma]", ",", "Last"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"min\[Delta]", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MinimalBy", "[", 
        RowBox[{"res\[Sigma]", ",", "Last"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Fit", " ", "print", " ", "and", " ", "plot", " ", "the", " ", "obtimal", " ",
     "arrangement"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"w", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m02p", "+", 
      RowBox[{"\[Mu]p", "*", "n"}]}], ",", 
     RowBox[{"m02", "+", 
      RowBox[{"\[Mu]", "*", "n"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"Extract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", "\[Theta]", "]"}], ".", "w"}], ",", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"f1", "[", "n_", "]"}], "=", "g1"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"Extract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", "\[Theta]", "]"}], ".", "w"}], ",", 
     "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"f2", "[", "n_", "]"}], "=", "g2"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "[", 
         FractionBox[
          RowBox[{"n", "+", "1"}], "2"], "]"}], ",", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", "2"}], "]"}], "==", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f2", "[", 
         FractionBox["n", "2"], "]"}], ",", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"n", ",", "2"}], "]"}], "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"n", "==", "0"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"minm", ",", "f", ",", 
     RowBox[{"{", 
      RowBox[{
      "m02", ",", "m02p", ",", "\[Mu]p", ",", "\[Mu]", ",", "\[Theta]"}], 
      "}"}], ",", "n", ",", 
     RowBox[{"Weights", "->", 
      RowBox[{"1", "/", 
       RowBox[{"min\[Delta]", "^", "2"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"m\[Sigma]", "=", 
  RowBox[{
   RowBox[{"Normal", "[", "fit", "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{"n", "->", "1"}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Trajectory 1\>\"", ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"minm", "[", 
         RowBox[{"[", "j", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2", ",", 
          RowBox[{"Length", "[", "m", "]"}], ",", "2"}], "}"}]}], "]"}]}], 
     "}"}], "]"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "trajectories"}], "*)"}], " "}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Trajectory 2\>\"", ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"minm", "[", 
        RowBox[{"[", "j", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3", ",", 
         RowBox[{"Length", "[", "m", "]"}], ",", "2"}], "}"}]}], "]"}]}], 
    "}"}], "]"}], ";"}], "\n", 
 RowBox[{"Normal", "[", "fit", "]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<\!\(\*SuperscriptBox[\(R\), \(2\)]\)=\>\"", ",", 
    RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], ";"}]}], "Code",
