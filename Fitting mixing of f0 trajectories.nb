Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s not fix \[Sigma]", "Subsubsection",
 CellChangeTimes->{{3.987325668985897*^9, 
  3.9873256827838173`*^9}},ExpressionUUID->"5f8acf0f-5f70-5d43-9f66-\
2376cc586b77"],

Cell[TextData[{
 "Now let\[CloseCurlyQuote]s not fix \[Sigma], so use from the second to the \
9th lighter resonances, i.e. from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], "0"], "(", "980", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f_0(980)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0042a606-9723-e44a-b43b-08b2e306a776"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], "0"], "(", "2330", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f_0(2330)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6d64aca-9a38-9f47-8276-ee55100b3451"],
 ". See if any arrangement gives reasonable results and see if what value for \
\[Sigma] mass we obtain."
}], "Text",
 CellChangeTimes->{{3.987325690064636*^9, 3.9873257702212486`*^9}, {
  3.9873258794630947`*^9, 3.9873259126161423`*^9}, {3.9873260721439266`*^9, 
  3.987326081220459*^9}},ExpressionUUID->"53683011-e066-3247-8b5a-\
2a782f4275d4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.980", ",", "2.19", ",", "3.92", ",", "4.78", ",", "1.81", ",", "3.06", 
     ",", "4.38", ",", "5.46"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]masses", "=", 
   RowBox[{"{", 
    RowBox[{
    "0.099", ",", "0.0096", ",", "0.87", ",", "0.46", ",", "0.24", ",", 
     "0.20", ",", "0.61", ",", "0.41"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2\[Sigma]", "=", "0.23"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]m2\[Sigma]", "=", "0.13"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"masseswith\[Delta]", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"masses", ",", "i"}], "]"}], ",", 
        RowBox[{"Extract", "[", 
         RowBox[{"\[Delta]masses", ",", "i"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "masses", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Definie", " ", "the", " ", "masses", " ", "their", " ", 
    RowBox[{"errors", "."}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"permmasses", "=", 
    RowBox[{"Permutations", "[", "masseswith\[Delta]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Get", " ", "all", " ", "the", " ", "permutations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"trajectories", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "permmasses", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"(*", 
    RowBox[{
    "Organise", " ", "the", " ", "permutations", " ", "in", " ", "order", " ",
      "tot", " ", "get", " ", "the", " ", "two", " ", "trajectories"}], 
    "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"m1", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "4"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"m2", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"permmasses", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;", 
          RowBox[{"Length", "[", "masseswith\[Delta]", "]"}]}], "]"}], "]"}], 
       ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"trajectory", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.43", ",", "0.13"}], "}"}], "}"}]}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", "4"}], ",", 
      RowBox[{"j", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m1", ",", "j"}], "]"}]}], "]"}], ";", "\n", "\t\t", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"trajectory", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{"m2", ",", "j"}], "]"}]}], "]"}], ";"}]}], "\n", "\t", 
     "]"}], ";", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"trajectories", ",", "trajectory"}], "]"}], "==", "False"}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"trajectories", ",", "trajectory"}], "]"}]}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "with", " ", "this", " ", "method", " ", "we", " ", "get", " ", 
     "repeated", " ", "arranges"}], ",", " ", 
    RowBox[{"so", " ", 
     RowBox[{"let", "'"}], "s", " ", "keep", " ", "them", " ", "only", " ", 
     "if", " ", "they", " ", "are", " ", "no", " ", "already", " ", "there"}],
     ",", " ", 
    RowBox[{"now", " ", "we", " ", 
     RowBox[{"dont", "'"}], " ", "have", " ", "any", " ", "double", " ", 
     "counting", " ", "as", " ", "we", " ", "will", " ", "consider", " ", 
     "trajectory", " ", "1", " ", "as", " ", "the", " ", "one", " ", "with", " ",
      "the", " ", "initial", " ", "resonance", " ", "the", " ", 
     RowBox[{"\[Sigma]", "."}]}]}], "*)"}], "\n", "]"}], "\n", 
 RowBox[{"Length", "[", "trajectories", "]"}]}], "Code",
 CellChangeTimes->{{3.9873261210053387`*^9, 3.987326189996973*^9}, {
  3.987326320973526*^9, 3.987326396466585*^9}, {3.9873264566753864`*^9, 
  3.9873264862312775`*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"1bf6c9c7-c015-6b43-b058-d1fe830a0147"],

