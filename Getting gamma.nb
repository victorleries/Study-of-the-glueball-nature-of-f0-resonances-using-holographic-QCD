Cell["With the following redefined function:", "Text",
 CellChangeTimes->{{3.988629175422497*^9, 
  3.988629187995447*^9}},ExpressionUUID->"e292f372-1245-0f4d-b700-\
431b32079266"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"v3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m02", "+", 
         RowBox[{"\[Mu]", "*", "n"}]}], ")"}], "/", 
       RowBox[{"3", "^", "2"}]}]}], ",", 
     RowBox[{"a", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m02s", "+", 
         RowBox[{"\[Mu]", "*", "n"}]}], ")"}], "/", 
       RowBox[{"3", "^", "2"}]}]}], ",", 
     RowBox[{"c", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m02p", "+", 
         RowBox[{"\[Mu]p", "*", "n"}]}], ")"}], "/", 
       RowBox[{"9", "^", "2"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v3p", "=", 
   RowBox[{
    RowBox[{"EulerMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], "]"}], ".",
     "v3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"h1", "[", "n_", "]"}], "=", 
     RowBox[{"v3p", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"h2", "[", "n_", "]"}], "=", 
     RowBox[{"v3p", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"h3", "[", "n_", "]"}], "=", 
     RowBox[{"v3p", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "[", 
         FractionBox[
          RowBox[{"n", "+", "2"}], "3"], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"n", ",", "3"}], "]"}], "==", "2"}], "&&", 
         RowBox[{"n", ">", "0"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h2", "[", 
         FractionBox[
          RowBox[{"n", "+", "1"}], "3"], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"n", ",", "3"}], "]"}], "==", "1"}], "&&", 
         RowBox[{"n", ">", "0"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h3", "[", 
         FractionBox["n", "3"], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"n", ",", "3"}], "]"}], "==", "0"}], "&&", 
         RowBox[{"n", ">", "0"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m02", ",", 
        RowBox[{"n", "==", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m02s", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "1"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m02p", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "2"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "4"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]p", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "3"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "5"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "6"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]", ",", 
        RowBox[{"n", "==", 
         RowBox[{"-", "7"}]}]}], "}"}]}], "}"}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9886292136371193`*^9, 3.988629279112528*^9}, {
  3.988631869237831*^9, 3.988631872732271*^9}, {3.9886339318117123`*^9, 
