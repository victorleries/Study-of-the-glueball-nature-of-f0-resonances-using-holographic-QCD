Cell[BoxData[{
 RowBox[{
  RowBox[{"v3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", "*", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"m02", "+", 
         RowBox[{"\[Mu]", "*", "n"}]}], "]"}], "/", "3"}]}], ",", 
