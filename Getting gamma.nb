        RowBox[{"m02s", "+", 
         RowBox[{"\[Mu]", "*", "n"}]}], "]"}], "/", "3"}]}], ",", 
     RowBox[{"c", "*", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"m02p", "+", 
         RowBox[{"\[Mu]p", "*", "n"}]}], "]"}], "/", "9"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"v3p", "=", 
   RowBox[{
    RowBox[{"EulerMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], "]"}], ".",
     "v3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"f1", "[", "n_", "]"}], "=", 
     RowBox[{"v3p", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
