 CellLabel->
  "In[221]:=",ExpressionUUID->"8bab7a1c-896f-6147-9b2d-b1ecf667c21b"],

Cell["Now let\[CloseCurlyQuote]s do the fit and see what pops out.", "Text",
 CellChangeTimes->{{3.988629553283087*^9, 
  3.988629562570364*^9}},ExpressionUUID->"c895e581-1465-5a40-88bb-\
4ff13e1e83a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fit", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"sdata", ",", "h", ",", 
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "m02", ",", "m02s", ",", "m02p", ",", 
       "\[Mu]p", ",", "\[Mu]", ",", "\[Alpha]", ",", "\[Beta]", ",", 
       "\[Gamma]"}], "}"}], ",", "n", ",", 
     RowBox[{"Weights", "->", 
      RowBox[{"1", "/", 
       RowBox[{"s\[Delta]data", "^", "2"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "//", 
  "MatrixForm"}], "\n", 
 RowBox[{"Sqrt", "[", 
  RowBox[{"Diagonal", "[", 
   RowBox[{"fit", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "]"}], "\n", 
 RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], "Code",
