     RowBox[{"f3", "[", "n_", "]"}], "=", 
     RowBox[{"v3p", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", "=", 
