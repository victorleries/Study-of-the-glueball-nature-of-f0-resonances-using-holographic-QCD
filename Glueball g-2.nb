Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a\[Mu]G", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]a\[Mu]G", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<", "11"}], ",", 
    RowBox[{"i", "++"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"sima\[Mu]", "=", 
      RowBox[{"{", "}"}]}], ";", "\n", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "<", "101"}], ",", 
       RowBox[{"j", "++"}], ",", "\n", "\t\t", 
       RowBox[{
        RowBox[{"numbers", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mmu", "->", "0.1056583755"}], ",", 
           RowBox[{"n", "->", "i"}], ",", 
           RowBox[{"\[Mu]", "->", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"2.67", ",", "0.14"}], "]"}], "]"}]}], ",", 
           RowBox[{"m20", "->", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{
               RowBox[{"-", "1.98"}], ",", "0.14"}], "]"}], "]"}]}], ",", 
           RowBox[{"m2\[Rho]", "->", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0.582", ",", "0.055"}], "]"}], "]"}]}], ",", 
           RowBox[{"\[CapitalGamma]", "->", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{
               RowBox[{"2.9", "*", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "6"}], ")"}]}]}], ",", 
               RowBox[{"1.3", "*", 
                RowBox[{"10", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "6"}], ")"}]}]}]}], "]"}], "]"}]}], ",", 
           RowBox[{"\[Alpha]", "->", 
            RowBox[{"1", "/", "137.035999177"}]}]}], "}"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"a\[Mu]1", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"wf1", "[", 
                RowBox[{"Q1", ",", "Q2"}], "]"}], 
               RowBox[{"f1", "[", 
                RowBox[{"Q1", ",", "Q2"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"wg2", "[", 
                RowBox[{
                 RowBox[{"Sqrt", "[", "m2\[Rho]", "]"}], ",", "Q1", ",", 
                 "Q2"}], "]"}], 
               RowBox[{"g1", "[", 
                RowBox[{"Q1", ",", "Q2"}], "]"}]}]}], ")"}], "/.", 
            "numbers"}], ",", 
           RowBox[{"{", 
            RowBox[{"Q1", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Q2", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"MaxRecursion", "\[Rule]", "2000"}], ",", " ", 
           RowBox[{"WorkingPrecision", "\[Rule]", "40"}], ",", 
           RowBox[{"MinRecursion", "\[Rule]", "20"}], ",", " ", 
           RowBox[{"AccuracyGoal", "\[Rule]", "10"}]}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"a\[Mu]2", "=", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"wg2", "[", 
                RowBox[{
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"\[Mu]", "*", "n"}], "+", "m20"}], "]"}], ",", 
                 "Q1", ",", "Q2"}], "]"}], 
               RowBox[{"g2G", "[", 
                RowBox[{"Q1", ",", "Q2"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"wg2", "[", 
                RowBox[{
                 RowBox[{"Sqrt", "[", "m2\[Rho]", "]"}], ",", "Q1", ",", 
                 "Q2"}], "]"}], 
               RowBox[{"g2\[Rho]", "[", 
                RowBox[{"Q1", ",", "Q2"}], "]"}]}]}], ")"}], "/.", 
            "numbers"}], ",", 
           RowBox[{"{", 
            RowBox[{"Q1", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Q2", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"MaxRecursion", "\[Rule]", "2000"}], ",", " ", 
           RowBox[{"WorkingPrecision", "\[Rule]", "30"}], ",", 
           RowBox[{"MinRecursion", "\[Rule]", "20"}], ",", " ", 
           RowBox[{"AccuracyGoal", "\[Rule]", "10"}]}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"a\[Mu]", "=", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["\[Alpha]", "\[Pi]"], ")"}], "3"], 
          RowBox[{"(", 
           RowBox[{"a\[Mu]1", "+", "a\[Mu]2"}], ")"}]}]}], ";", "\n", "\t\t", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"sima\[Mu]", ",", 
          RowBox[{"a\[Mu]", "/.", "numbers"}]}], "]"}]}]}], "\n", "\t", "]"}],
      ";", "\n", "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"a\[Mu]G", ",", 
       RowBox[{"Mean", "[", "sima\[Mu]", "]"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"\[Delta]a\[Mu]G", ",", 
       RowBox[{"StandardDeviation", "[", "sima\[Mu]", "]"}]}], "]"}]}]}], 
   "\n", "]"}], ";"}], "\n", "a\[Mu]G", "\n", "\[Delta]a\[Mu]G"}], "Code",
