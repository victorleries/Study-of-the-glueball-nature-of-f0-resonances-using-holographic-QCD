Cell[TextData[{
 "Nah, it doesn\[CloseCurlyQuote]t work that well :(\nWe see that in this \
case the slope for glueballs is around the same order than the one for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3c2c5a9-03bb-ef46-aed0-eebe9cfb5d19"],
 " but with a heavier initial mass. So it seems that is the result of \
considering a mixing between light quarks and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s\\overline s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f57b9368-9bd3-cd45-a602-522ec52118c8"],
 ". In fact the initial mass of the light ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52ddd74b-d22c-a243-b3a3-9489012f639e"],
 " is around the order of the pion mass. So this looks as a very Naive \
approach. "
}], "Text",
 CellChangeTimes->{{3.9861075569758606`*^9, 3.9861075687895527`*^9}, {
   3.9861282654807243`*^9, 3.986128270224333*^9}, {3.986128989816143*^9, 
