Cell[CellGroupData[{
Cell[TextData[{
 "Computing the mixing and the value of the parameters from the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5e26a3e3-b12e-e049-bc4a-bf5185e4bc18"],
 " trajectory."
}], "Title",
 CellChangeTimes->{{3.9857507003816185`*^9, 3.985750731535944*^9}, {
  3.9857507802614975`*^9, 
  3.9857507833432426`*^9}},ExpressionUUID->"05d5b71d-4ac7-244a-97fb-\
7ef0b3c32748"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s first solve the system of equations in function of \
the already known parameters:\n\t- The slope of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c61f3ed-b1e6-9c45-afd0-7d90098c1de8"],
 " trajectory: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9df3579e-4f4c-1a4a-b6aa-8d8316e91945"],
 "\n\t- The physical masses.\nFor the unknown quantities of the system of \
equations let\[CloseCurlyQuote]s call them:\n\t- The mixing angle: \[Theta]\n\
\t- The initial mass of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f2171da-b32f-0b44-9140-132211fed8f3"],
 " trajectory: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["m", "TI"], "0", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "m_0^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0708c028-ef9b-1e44-bb0f-f9f5db55030e"],
 "\n\t- The slope of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["G", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "G^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c964e2cc-be44-214e-aaf4-be074a095978"],
 " trajectory: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Mu]", 
        RowBox[{"\[Prime]", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu'^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e463ca7-f432-4243-847e-8206f7121344"],
 "\n\t- The initial mass of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["G", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "G^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68e43fb9-968b-454a-a08d-14680c2acc88"],
 " trajectory: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["m", "TI"], "0", 
        RowBox[{"\[Prime]", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "m'^{2}_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5ea989a-76de-054b-8fa5-d59a2ebfdf22"]
}], "Text",
 CellChangeTimes->{{3.985750917205799*^9, 3.9857509585203743`*^9}, {
