Cell[TextData[{
 "This one also checks out, and the slope for glueballs is quite different \
than for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81e09920-0c08-914c-9dd3-3be81cee4d0f"],
 ", so if it was a mixing with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s\\overline s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27bc176d-d997-0048-b654-968e8734568b"],
 " it wouldn\[CloseCurlyQuote]t check out that the string force were so \
different."
}], "Text",
 CellChangeTimes->{{3.9861127389155235`*^9, 
  3.986112855866741*^9}},ExpressionUUID->"1e7b9c9e-b522-b142-a4bc-\
36ce152cc10f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Analytic solution", "Section",
 CellChangeTimes->{{3.9862018799359303`*^9, 
  3.986201898212494*^9}},ExpressionUUID->"2f3ebb4c-0e14-9c4a-a4b4-\
f96ba4b08ba8"],

Cell["\<\
Now let\[CloseCurlyQuote]s try to solve the system analytically so it\
\[CloseCurlyQuote]s easier to find how errors propagate.\
\>", "Text",
 CellChangeTimes->{{3.9862019091135216`*^9, 3.986201940152727*^9}, {
   3.986202067443159*^9, 3.9862020743421993`*^9}, 
   3.986202169976267*^9},ExpressionUUID->"b310eeaf-c9f4-a548-b54e-\
327719affaa1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\[Mu]", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"{", 
    RowBox[{"m02", ",", "m02p", ",", 
     RowBox[{"m02", "+", "\[Mu]"}], ",", 
     RowBox[{"m02p", "+", "\[Mu]p"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m10", "^", "2"}], ",", 
     RowBox[{"m20", "^", "2"}], ",", 
     RowBox[{"m11", "^", "2"}], ",", 
     RowBox[{"m12", "^", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anlsyst", "=", 
   RowBox[{"Extract", "[", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"m", "==", 
        RowBox[{"R", ".", "v"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "m02", ",", "m02p", ",", "\[Mu]p"}], "}"}]}],
       "]"}], ",", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anlsol", ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "m02", ",", "m02p", ",", "\[Mu]p"}], "}"}], "/.",
     "anlsyst"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m10", ",", "m20", ",", "m11", ",", "m12", ",", "\[Mu]"}], "}"}],
     ",", 
    RowBox[{
     RowBox[{"\[Theta]sol", "[", 
