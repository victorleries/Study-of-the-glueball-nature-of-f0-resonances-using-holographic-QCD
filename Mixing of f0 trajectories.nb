Cell[TextData[{
 "In this case the problem is bigger as, as for one solution we have a \
negative slope for glueballs and in the other case, an initial imaginary mass \
for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         OverscriptBox[
          StyleBox["q", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "q\\overline q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81cdee5b-8774-754c-8e9c-eb66875eb5d7"],
 " states. So none of the solutions are physical."
}], "Text",
 CellChangeTimes->{{3.9861077470956173`*^9, 3.986107753873312*^9}, {
  3.98610781198106*^9, 
  3.9861078709799747`*^9}},ExpressionUUID->"833a2c56-7517-ba4b-ad94-\
