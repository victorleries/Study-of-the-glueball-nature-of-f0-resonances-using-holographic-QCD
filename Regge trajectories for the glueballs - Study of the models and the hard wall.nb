Cell[CellGroupData[{

Cell["Study of the Hard Wall for Model A", "Section",
 CellChangeTimes->{{3.985524107035635*^9, 
  3.985524115125435*^9}},ExpressionUUID->"d32a1430-7d75-ec48-8749-\
ca5c0a6ba020"],

Cell["Now let\[CloseCurlyQuote]s repeat the process for model A.", "Text",
 CellChangeTimes->{{3.9855242368033314`*^9, 
  3.9855242583047867`*^9}},ExpressionUUID->"0bfa3377-7141-5b40-9001-\
ac2fa7f16709"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eigen2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDEigenvalues", "[", 
      RowBox[{
       RowBox[{"F", "[", "Z1", "]"}], ",", 
       RowBox[{"S", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "4"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z0", ",", "0.5", ",", "500", ",", "0.5"}], "}"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.985524277877163*^9, 3.9855243091710587`*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"46e2bb9b-aa59-0c4b-9836-c160bbef8784"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"trajectories", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"Eigen2", ",", "a"}], "]"}], ",", "b"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", 
       RowBox[{"Length", "[", "Eigen2", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R2fits", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"LinearModelFit", "[", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"trajectories", ",", "a"}], "]"}], ",", "x", ",", "x"}], 
       "]"}], "[", "\"\<RSquared\>\"", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", 
       RowBox[{"Length", "[", "trajectories", "]"}]}], "}"}]}], "]"}]}], 
