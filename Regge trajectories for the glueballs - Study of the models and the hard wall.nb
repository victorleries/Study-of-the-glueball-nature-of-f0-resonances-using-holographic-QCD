  "In[204]:=",ExpressionUUID->"0f1738e6-7a0a-cf41-a612-b2a32a881249"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"trajectoriesprec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"Extract", "[", 
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"Eigen1prec", ",", "a"}], "]"}], ",", "b"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", 
       RowBox[{"Length", "[", "Eigen1prec", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"R2fitsprec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"LinearModelFit", "[", 
       RowBox[{
        RowBox[{"Extract", "[", 
         RowBox[{"trajectoriesprec", ",", "a"}], "]"}], ",", "x", ",", "x"}], 
       "]"}], "[", "\"\<RSquared\>\"", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", 
       RowBox[{"Length", "[", "trajectoriesprec", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"z0valuesprec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"z0", ",", 
     RowBox[{"{", 
      RowBox[{"z0", ",", "1.5", ",", "2.5", ",", "0.001"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Extract", "[", 
        RowBox[{"z0valuesprec", ",", "i"}], "]"}], ",", 
       RowBox[{"Extract", "[", 
        RowBox[{"R2fitsprec", ",", "i"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "z0valuesprec", "]"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SubscriptBox[
StyleBox[\"z\", \"TI\"], \"0\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"z_0\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\"", 
      ",", "\"\<\!\(\*TemplateBox[<|\"boxes\" -> FormBox[
SuperscriptBox[
StyleBox[\"R\", \"TI\"], \"2\"], TraditionalForm], \"errors\" -> {}, \
\"input\" -> \"R^2\", \"state\" -> \
\"Boxes\"|>,\"TeXAssistantTemplate\"]\)\>\""}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"Z0Maxprec", "=", 
  RowBox[{"Extract", "[", 
   RowBox[{
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Extract", "[", 
             RowBox[{"z0valuesprec", ",", "i"}], "]"}], ",", 
            RowBox[{"Extract", "[", 
             RowBox[{"R2fitsprec", ",", "i"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "z0valuesprec", "]"}]}], "}"}]}], "]"}], ",",
         "Last"}], "]"}], ",", "1"}], "]"}], ",", "1"}], "]"}]}]}], "Code",
