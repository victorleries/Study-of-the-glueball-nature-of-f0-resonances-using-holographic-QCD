Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "V_Symbol", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"S", "''"}], "[", "z", "]"}]}], "+", 
    RowBox[{
     RowBox[{"V", "[", "z", "]"}], "*", 
     RowBox[{"S", "[", "z", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"A_Symbol", ",", "\[Phi]_Symbol"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"A", "[", "z", "]"}], ",", "z"}], "]"}], ",", "z"}], 
         "]"}]}], "+", 
       RowBox[{"3", "/", 
        RowBox[{"z", "^", "2"}]}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "z", "]"}], ",", "z"}], "]"}], ",", "z"}], 
        "]"}]}], ")"}], "/", "2"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"A", "[", "z", "]"}], ",", "z"}], "]"}]}], "-", 
        RowBox[{"3", "/", "z"}], "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "z", "]"}], ",", "z"}], "]"}]}], ")"}], "^", 
