9c99c19a6f8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eigen1prec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDEigenvalues", "[", 
      RowBox[{
       RowBox[{"F", "[", "Z2", "]"}], ",", 
       RowBox[{"S", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "4"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z0", ",", "1.5", ",", "2.5", ",", "0.001"}], "}"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9854072344637146`*^9, 3.985407254489361*^9}, {
  3.9854074517969513`*^9, 3.9854074529044476`*^9}},
