Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ae1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "a"}], "*", 
    RowBox[{"z", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]e1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z", "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"3", "*", "a", "*", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"2", "*", "a", "*", 
          RowBox[{"z", "^", "2"}]}]}], ")"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "*", 
     RowBox[{"Sqrt", "[", "6", "]"}], 
     RowBox[{"ArcSinh", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "*", 
         RowBox[{"a", "/", "3"}]}], "]"}], "*", "z"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S11", "=", 
   RowBox[{
    RowBox[{"Ae1", "[", "z", "]"}], "-", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "/", "6"}], "]"}], "*", 
     RowBox[{"\[Phi]e1", "[", "z", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S12", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"8", "/", "3"}], "]"}], "*", 
    RowBox[{"\[Phi]e1", "[", "z", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"As1", "[", "z_", "]"}], ":=", "S11"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]s1", "[", "z_", "]"}], ":=", "S12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v1", "=", 
