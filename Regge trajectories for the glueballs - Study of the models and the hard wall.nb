Cell[CellGroupData[{

Cell["Study of the hard wall for Model B", "Section",
 CellChangeTimes->{{3.9853240657877407`*^9, 3.9853240702939205`*^9}, {
  3.9855240856924057`*^9, 
  3.9855240952148247`*^9}},ExpressionUUID->"11a22b6d-55e4-0041-aa30-\
c5af74c88b38"],

Cell[TextData[{
 "We have just seen that the numeric results diverge as the upper bound of z \
increases, so it looks like we have to add a hard wall on top of the already \
soft wall model. So let\[CloseCurlyQuote]s see which is the upper bound of z \
that gives us the best value for \.08",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "R^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5727afaf-473b-8146-af51-1c549c81b466"],
 ". This is done now for Model B."
}], "Text",
 CellChangeTimes->{{3.9853241174186*^9, 3.985324174560047*^9}, {
  3.98532421091757*^9, 3.985324263125721*^9}, {3.985328898637207*^9, 
  3.9853289188789825`*^9}, {3.9854071583426304`*^9, 
  3.9854071697911167`*^9}},ExpressionUUID->"f5c1d611-87d6-2940-aebf-\
d9c159381280"],

Cell[CellGroupData[{

