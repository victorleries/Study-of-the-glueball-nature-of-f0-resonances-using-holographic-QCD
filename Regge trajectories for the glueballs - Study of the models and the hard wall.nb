Cell[CellGroupData[{
Cell[TextData[{
 "Solution for the spectra of the masses of the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["0", "++"], TraditionalForm], "errors" -> {}, "input" -> 
     "0^{++}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73cb7c47-c832-3441-a60f-4838c092a0da"],
 " glueball according to the paper by Zhang, et al. 2022"
}], "Title",
 CellChangeTimes->{{3.9835957761844635`*^9, 
  3.983595861493908*^9}},ExpressionUUID->"04bff5be-c473-3948-8483-\
40029d4e836c"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s first define the generic Equation to solve and the \
shape of the potential in terms of A and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPhi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
