e053461f0b92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eigenB", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NDEigenvalues", "[", 
        RowBox[{
         RowBox[{"F", "[", "Z2", "]"}], ",", 
         RowBox[{"S", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "4"}], "]"}], ",", 
       RowBox[{"{", 
