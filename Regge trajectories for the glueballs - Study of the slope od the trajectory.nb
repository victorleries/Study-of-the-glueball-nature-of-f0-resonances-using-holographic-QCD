Notebook[{

Cell[CellGroupData[{
Cell["\<\
Study of the dependance of the Regge trajectory slope with respect to the \
model\[CloseCurlyQuote]s parameter.\
\>", "Title",
 CellChangeTimes->{{3.9855814839813766`*^9, 
  3.9855815401812706`*^9}},ExpressionUUID->"c0c6b9bc-d609-fb40-8eea-\
9d63ef98606f"],

Cell["\<\
Now let\[CloseCurlyQuote]s study how the slope of the Regge trajectory \
changes with a or with b. To achieve so let\[CloseCurlyQuote]s compute the \
slope for several values of a and b.\
\>", "Text",
 CellChangeTimes->{{3.9855815494802494`*^9, 
  3.9855816118412857`*^9}},ExpressionUUID->"0baf081f-e7ec-f74f-ad85-\
bdfd8a0365ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "V_Symbol", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"S", "''"}], "[", "z", "]"}]}], "+", 
    RowBox[{
     RowBox[{"V", "[", "z", "]"}], "*", 
     RowBox[{"S", "[", "z", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"A_Symbol", ",", "\[Phi]_Symbol"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"A", "[", "z", "]"}], ",", "z"}], "]"}], ",", "z"}], 
         "]"}]}], "+", 
       RowBox[{"3", "/", 
        RowBox[{"z", "^", "2"}]}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Phi]", "[", "z", "]"}], ",", "z"}], "]"}], ",", "z"}], 
        "]"}]}], ")"}], "/", "2"}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"A", "[", "z", "]"}], ",", "z"}], "]"}]}], "-", 
        RowBox[{"3", "/", "z"}], "-", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "z", "]"}], ",", "z"}], "]"}]}], ")"}], "^", 
      "2"}], "/", "4"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{3.9855820379492073`*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"a7424319-fa43-f444-abbf-21358c17de04"],

Cell[TextData[{
 "We define the face space of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["z", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "z_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bef3dffb-29f4-e241-abe3-246b5beb17aa"],
 " and the values of the parameters."
}], "Text",
 CellChangeTimes->{{3.985586596391657*^9, 
  3.985586622291712*^9}},ExpressionUUID->"0fac6479-8b12-6148-8d1a-\
a3bb8c8d3be3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0values", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"z0", ",", 
     RowBox[{"{", 
      RowBox[{"z0", ",", "0.5", ",", "10", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"paramvalues", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"a", ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0.1", ",", "1.5", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.9855825977686157`*^9, 3.985582648224716*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"17488848-99f4-f74c-a3e5-7a217884f91b"],

Cell[CellGroupData[{

Cell["Model A", "Section",
 CellChangeTimes->{{3.9855816281554184`*^9, 
  3.9855816343586864`*^9}},ExpressionUUID->"8d7b42d5-c655-fc46-a158-\
1e161717d0e0"],

Cell["Build the differential operator for model A", "Text",
 CellChangeTimes->{{3.985586638933567*^9, 
  3.985586670424774*^9}},ExpressionUUID->"bb41d547-27f9-1345-a0a7-\
c8b7b954aea7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ae1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "a"}], "*", 
    RowBox[{"z", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]e1", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{"z", "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"3", "*", "a", "*", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"2", "*", "a", "*", 
          RowBox[{"z", "^", "2"}]}]}], ")"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "*", 
     RowBox[{"Sqrt", "[", "6", "]"}], 
     RowBox[{"ArcSinh", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "*", 
         RowBox[{"a", "/", "3"}]}], "]"}], "*", "z"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S11", "=", 
   RowBox[{
    RowBox[{"Ae1", "[", "z", "]"}], "-", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "/", "6"}], "]"}], "*", 
     RowBox[{"\[Phi]e1", "[", "z", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S12", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"8", "/", "3"}], "]"}], "*", 
    RowBox[{"\[Phi]e1", "[", "z", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"As1", "[", "z_", "]"}], ":=", "S11"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]s1", "[", "z_", "]"}], ":=", "S12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v1", "=", 
   RowBox[{"V", "[", 
    RowBox[{"As1", ",", "\[Phi]s1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Z1", "[", "z_", "]"}], ":=", "v1"}], ";"}]}], "Code",
 CellChangeTimes->{3.985582006665495*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"cf21e458-dd93-a64e-a14b-122efa454639"],

Cell[TextData[{
 "Get the first 4 eigenvalues for every value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["z", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "z_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4afbf77-e908-db42-8475-c2978f726134"],
 " and the parameter."
}], "Text",
 CellChangeTimes->{{3.9855866825375805`*^9, 3.985586692464691*^9}, {
  3.9855867588111076`*^9, 
  3.9855867816561737`*^9}},ExpressionUUID->"2e54f062-ea46-e545-b1d7-\
74c77faaa9d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"eigenA", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NDEigenvalues", "[", 
        RowBox[{
         RowBox[{"F", "[", "Z1", "]"}], ",", 
         RowBox[{"S", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "z0"}], "}"}], ",", "4"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z0", ",", "0.5", ",", "10", ",", "0.1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0.1", ",", "1.5", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.985582060932871*^9, 3.9855820632818966`*^9}, {
