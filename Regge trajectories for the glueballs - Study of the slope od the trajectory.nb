       RowBox[{"Length", "[", "paramvalues", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"R2B", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"LinearModelFit", "[", 
         RowBox[{
          RowBox[{"Extract", "[", 
           RowBox[{
            RowBox[{"Extract", "[", 
             RowBox[{"trajectoriesB", ",", "b"}], "]"}], ",", "z0"}], "]"}], ",",
           "x", ",", "x"}], "]"}], "[", "\"\<RSquared\>\"", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z0", ",", "1", ",", 
         RowBox[{"Length", "[", "z0values", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "1", ",", 
       RowBox[{"Length", "[", "paramvalues", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"z0maxB", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Extract", "[", 
      RowBox[{
       RowBox[{"Extract", "[", 
        RowBox[{
         RowBox[{"Extract", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"MaximalBy", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Extract", "[", 
                    RowBox[{"z0values", ",", "i"}], "]"}], ",", 
                   RowBox[{"Extract", "[", 
                    RowBox[{
                    RowBox[{"Extract", "[", 
                    RowBox[{"R2B", ",", "b"}], "]"}], ",", "i"}], "]"}]}], 
                  "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "[", "z0values", "]"}]}], "}"}]}], "]"}],
                ",", "Last"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"b", ",", "1", ",", 
               RowBox[{"Length", "[", "paramvalues", "]"}]}], "}"}]}], "]"}], 
           ",", "j"}], "]"}], ",", "1"}], "]"}], ",", "1"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "paramvalues", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.9855998594702625`*^9, 3.9855999483694706`*^9}},
