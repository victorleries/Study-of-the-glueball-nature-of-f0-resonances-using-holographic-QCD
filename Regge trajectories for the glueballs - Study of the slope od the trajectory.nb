Cell["Build the differential operator for model B.", "Text",
 CellChangeTimes->{{3.985599712620674*^9, 
  3.9855997155694942`*^9}},ExpressionUUID->"d93b71ab-f714-f945-a97b-\
11a7f21bb3e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ae2", "[", "z_", "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"3", "/", "8"}], ")"}]}], "*", 
        RowBox[{"3", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "8"}], ")"}]}], "*", 
        RowBox[{"Gamma", "[", 
         RowBox[{"5", "/", "4"}], "]"}], "*", 
        RowBox[{"BesselI", "[", 
         RowBox[{
          RowBox[{"1", "/", "4"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "*", 
             RowBox[{"z", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Sqrt", "[", "6", "]"}], ")"}]}]}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"b", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "4"}], ")"}]}], "*", 
        RowBox[{"Sqrt", "[", "z", "]"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]e2", "[", "z_", "]"}], ":=", 
   RowBox[{"b", "*", 
    RowBox[{"z", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S21", "=", 
   RowBox[{
    RowBox[{"Ae2", "[", "z", "]"}], "-", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "/", "6"}], "]"}], "*", 
     RowBox[{"\[Phi]e2", "[", "z", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S22", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"8", "/", "3"}], "]"}], "*", 
    RowBox[{"\[Phi]e2", "[", "z", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"As2", "[", "z_", "]"}], ":=", "S21"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]s2", "[", "z_", "]"}], ":=", "S22"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v2", "=", 
   RowBox[{"V", "[", 
    RowBox[{"As2", ",", "\[Phi]s2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Z2", "[", "z_", "]"}], ":=", "v2"}], ";"}]}], "Code",
 CellChangeTimes->{3.985599738751564*^9},
 CellLabel->"In[45]:=",ExpressionUUID->"bd9a798e-02fe-a441-9f15-93643964c617"],

Cell[TextData[{
 "Get the first 4 eigenvalues for every value of ",
