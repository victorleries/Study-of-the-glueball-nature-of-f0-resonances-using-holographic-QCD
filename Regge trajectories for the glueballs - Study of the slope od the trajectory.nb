Cell[BoxData[{
 RowBox[{
  RowBox[{"trajectoriesB", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"Extract", "[", 
            RowBox[{
             RowBox[{"Extract", "[", 
              RowBox[{
               RowBox[{"Extract", "[", 
                RowBox[{"eigenB", ",", "b"}], "]"}], ",", "z0"}], "]"}], ",", 
             "n"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z0", ",", "1", ",", 
         RowBox[{"Length", "[", "z0values", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
