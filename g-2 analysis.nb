Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"numbers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", 
      RowBox[{"a\[Mu]G", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"\[Delta]a", "->", 
      RowBox[{"\[Delta]a\[Mu]G", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"fitG", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{"\[Delta]m", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"fitG", "[", "\"\<CovarianceMatrix\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"a_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"a", "*", 
      RowBox[{"n", "^", 
       RowBox[{"(", 
        RowBox[{"-", "m"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"f", "[", 
  RowBox[{"a", ",", "m"}], "]"}], "\n", 
 RowBox[{"\[Delta]a\[Mu]Gtot", "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"a", ",", "m"}], "]"}], ",", "a"}], "]"}], "^", "2"}], "*", 
      RowBox[{"\[Delta]a", "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"a", ",", "m"}], "]"}], ",", "m"}], "]"}], "^", "2"}], "*", 
      RowBox[{"\[Delta]m", "^", "2"}]}]}], "]"}], "/.", 
   "numbers"}]}]}], "Code",
 CellChangeTimes->{{3.9906793743710327`*^9, 3.990679426212103*^9}, {
