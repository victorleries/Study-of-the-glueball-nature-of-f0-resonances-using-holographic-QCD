Cell["\<\
Now to know how this resonances contribute let\[CloseCurlyQuote]s get our \
contribution. For that we need the values of the 2 first resonances of the \
mathematical resonances and then we will need to mix them.\
\>", "Text",
 CellChangeTimes->{{3.9906934157910233`*^9, 3.99069348245397*^9}, {
   3.99069354989398*^9, 3.990693557762842*^9}, {3.990693764779686*^9, 
   3.9906937798826885`*^9}, 
   3.9907957234012165`*^9},ExpressionUUID->"1b3fd02d-290e-c646-b967-\
07ba40190d76"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"numbers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Ga\[Mu]", "->", 
      RowBox[{"a\[Mu]G", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"qqa\[Mu]", "->", 
      RowBox[{"a\[Mu]qq", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"ssa\[Mu]", "->", 
      RowBox[{"a\[Mu]ss", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"\[Alpha]", "\[Rule]", "0.68675197365457`"}], ",", 
     RowBox[{"\[Beta]", "\[Rule]", "1.6333921503359397`"}], ",", 
     RowBox[{"\[Gamma]", "\[Rule]", "2.228044499214222`"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]numbers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Delta]Ga\[Mu]", "->", 
      RowBox[{"\[Delta]a\[Mu]G", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"\[Delta]qqa\[Mu]", "->", 
      RowBox[{"\[Delta]a\[Mu]qq", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"\[Delta]ssa\[Mu]", "->", 
      RowBox[{"\[Delta]a\[Mu]ss", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"\[Delta]\[Alpha]", "->", "0.04535902419"}], ",", 
     RowBox[{"\[Delta]\[Beta]", "->", 
      RowBox[{"Sqrt", "[", "0.003636752225500608", "]"}]}], ",", 
     RowBox[{"\[Delta]\[Gamma]", "->", 
      RowBox[{"Sqrt", "[", "0.0008335043663459319", "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mixeda\[Mu]1", "=", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"{", 
      RowBox[{"Ga\[Mu]", ",", "qqa\[Mu]", ",", "ssa\[Mu]"}], "}"}], "]"}], "/.",
     "numbers"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]mixeda\[Mu]1", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Delta]Ga\[Mu]", ",", "\[Delta]qqa\[Mu]", ",", "\[Delta]ssa\[Mu]"}],
         "}"}], "^", "2"}], "]"}], "]"}], "/.", 
    RowBox[{"Join", "[", 
     RowBox[{"numbers", ",", "\[Delta]numbers"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numbers", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Ga\[Mu]", "->", 
      RowBox[{"a\[Mu]G", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"qqa\[Mu]", "->", 
      RowBox[{"a\[Mu]qq", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"ssa\[Mu]", "->", 
      RowBox[{"a\[Mu]ss", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"\[Alpha]", "\[Rule]", "0.68675197365457`"}], ",", 
     RowBox[{"\[Beta]", "\[Rule]", "1.6333921503359397`"}], ",", 
     RowBox[{"\[Gamma]", "\[Rule]", "2.228044499214222`"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mixeda\[Mu]2", "=", 
   RowBox[{
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"EulerMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], 
          "]"}], ".", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"{", 
           RowBox[{"Ga\[Mu]", ",", "qqa\[Mu]", ",", "ssa\[Mu]"}], "}"}], 
          "]"}]}], ")"}], "/.", "numbers"}], ",", "1"}], "]"}], "^", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
      "qqa\[Mu]", ",", "ssa\[Mu]"}], "}"}], ",", 
    RowBox[{
     RowBox[{"errormixed1", "[", 
      RowBox[{
      "\[Alpha]_", ",", "\[Beta]_", ",", "\[Gamma]_", ",", "Ga\[Mu]_", ",", 
       "qqa\[Mu]_", ",", "ssa\[Mu]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Extract", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"EulerMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]"}], "}"}], 
           "]"}], ".", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"{", 
            RowBox[{"Ga\[Mu]", ",", "qqa\[Mu]", ",", "ssa\[Mu]"}], "}"}], 
           "]"}]}], ")"}], ",", "1"}], "]"}], "^", "2"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]mixeda\[Mu]2", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "\[Alpha]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]\[Alpha]", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "\[Beta]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]\[Beta]", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "\[Gamma]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]\[Gamma]", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "Ga\[Mu]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]Ga\[Mu]", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "qqa\[Mu]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]qqa\[Mu]", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"errormixed1", "[", 
           RowBox[{
           "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "Ga\[Mu]", ",", 
            "qqa\[Mu]", ",", "ssa\[Mu]"}], "]"}], ",", "ssa\[Mu]"}], "]"}], "^",
         "2"}], "*", 
       RowBox[{"\[Delta]ssa\[Mu]", "^", "2"}]}]}], "]"}], "/.", 
    RowBox[{"Join", "[", 
     RowBox[{"numbers", ",", "\[Delta]numbers"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"mixeda\[Mu]", "=", 
  RowBox[{"mixeda\[Mu]1", "+", "mixeda\[Mu]2"}]}], "\n", 
 RowBox[{"\[Delta]mixeda\[Mu]", "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{"\[Delta]mixeda\[Mu]1", "^", "2"}], "+", 
    RowBox[{"\[Delta]mixeda\[Mu]2", "^", "2"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.990693592813648*^9, 3.9906936879242973`*^9}, {
