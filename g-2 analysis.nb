Cell["\<\
Comparison of the known contribution with the total contribution\
\>", "Section",
 CellChangeTimes->{{3.9906771547789135`*^9, 
  3.990677172732067*^9}},ExpressionUUID->"a014e32d-39df-344b-aa26-\
c76137014716"],

Cell[TextData[{
 "In (Knecht et al., 2018) the compute the contribution for the following \
scalar mesons:",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
      "f_0", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "4f827948-5c30-394e-b369-f9e362d88149"],
 "(500), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd907b9a-6656-9341-985c-49efcca7af79"],
 "(980), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8e57b90-982d-a74a-9042-bb530c3bbe0b"],
 "(1370) and the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "f_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d93a2809-5885-6c47-944f-5add9dad410b"],
 "(1500). Now let\[CloseCurlyQuote]s see what is the contribution of these \
resonances to the total HLbL contribution to see the underestimation that \
they did in their calculation:\n\nSo what they got was:"
}], "Text",
 CellChangeTimes->{{3.9906771811796913`*^9, 3.990677182116495*^9}, {
