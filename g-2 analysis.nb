Cell["Total Contribution", "Section",
 CellChangeTimes->{{3.9906747336531334`*^9, 
  3.990674736935911*^9}},ExpressionUUID->"d6ad4861-c029-3146-8ab3-\
4a2c47c985eb"],

Cell["\<\
Now let\[CloseCurlyQuote]s fit the 10 points to a series depending on n in \
order to get a series that we can sum up to infinity, and get the whole \
contribution:\
\>", "Text",
 CellChangeTimes->{{3.990674748840967*^9, 3.9906747518562145`*^9}, {
  3.990674790263321*^9, 
  3.9906748551164627`*^9}},ExpressionUUID->"f064aa95-f8c3-fd4c-950f-\
53ff8ba655fc"],

Cell["Glueballs:", "Text",
 CellChangeTimes->{{3.9906748684914875`*^9, 
  3.990674870411148*^9}},ExpressionUUID->"3a6db2a5-3e9e-404d-994d-\
7496f79f7d5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ai", "[", "n_", "]"}], ":=", 
   RowBox[{"a", "*", 
    RowBox[{"n", "^", 
     RowBox[{"(", 
      RowBox[{"-", "m"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a\[Mu]Gdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"a\[Mu]G", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "a\[Mu]G", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fitG", "=", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{"a\[Mu]Gdata", ",", 
     RowBox[{"ai", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "m"}], "}"}], ",", "n", ",", 
     RowBox[{"Weights", "->", 
      RowBox[{"1", "/", 
       RowBox[{"\[Delta]a\[Mu]G", "^", "2"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"fitG", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"fitG", "[", "\"\<CovarianceMatrix\>\"", "]"}], "]"}], "\n", 
 RowBox[{"fitG", "//", "Normal"}], "\n", 
 RowBox[{
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", 
    RowBox[{
     RowBox[{"A", "[", "n_", "]"}], ":=", 
     RowBox[{"fitG", "//", "Normal"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{"a\[Mu]Gtot", "=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"A", "[", "n", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "\[Infinity]"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"fitG", "[", "\"\<ANOVATableMeanSquares\>\"", "]"}], "[", 
  RowBox[{"[", "2", "]"}], "]"}]}], "Code",
 CellChangeTimes->{{3.9906748784841137`*^9, 3.990674879071148*^9}, {
   3.9906749522674522`*^9, 3.9906750753363113`*^9}, 3.9906751088686523`*^9, {
